@model PostViewModel

@{
    ViewData["Title"] = "Create Post";
}

<style>
    .content-wrapper {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
        font-family: sans-serif;
    }
</style>



<div class="content-wrapper">
    <div class="row">
        <div class="col-6">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Index" asp-controller="Post" class="btn btn-primary">Back to List</a>
        </div>
    </div>

    <hr />

    <div class="validation-summary">
        <div asp-validation-summary="All" class="text-danger"></div>
    </div>
    <form asp-action="Create" asp-controller="Post" enctype="multipart/form-data" method="post">

        <div class="form-group">
            <label asp-for="post.Title">Title</label>
            <input asp-for="post.Title" class="form-control" />
            <span asp-validation-for="post.Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="post.CategoryId">Category</label>
            <select asp-for="post.CategoryId" class="form-control" asp-items="Model.Categories">
                <option value="">-- Select Category --</option>
            </select>
            <span asp-validation-for="post.CategoryId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="post.Author">Author</label>
            <input asp-for="post.Author" class="form-control" />
            <span asp-validation-for="post.Author" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="post.Content">Content</label>
            <textarea asp-for="post.Content" class="form-control" rows="5"></textarea>
            <span asp-validation-for="post.Content" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="FeatureImage">Feature Image</label>
            <input asp-for="FeatureImage" class="form-control" type="file" />
        </div>
        <br />
        <div class="form-group">
            <button type="submit" class="btn btn-success  mt-1">Create</button>
            <button type="reset" class="btn btn-secondary  mt-1">Reset</button>
            <a asp-action="Index" class="btn btn-primary mt-1">Back to List</a>
        </div>
    </form>
</div>

@section Scripts{
    <script src="https://cdn.tiny.cloud/1/umjzcu41piswylls1ovvb62qiy6661zzwzw6fsqmqonuac1u/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
    <script>
        tinymce.init({
            selector: 'textarea'
        });
    </script>
}