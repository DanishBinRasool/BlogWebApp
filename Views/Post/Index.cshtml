@model IEnumerable<Post>
@{
    ViewData["Title"] = "Blog Posts";
}

<div class="text-center m-4 sticky-top">
    @if(ViewBag.Categories != null )
    {
        foreach (var category in ViewBag.Categories)
        {
            <a asp-action="Index" asp-controller="Post" asp-route-categoryId="@category.Id"
            class="badge bg-warning text-decoration-none  ms-2">@category.Name</a>
        }
    }
</div>

<div class="text-end my-1">
    <a class="btn btn-primary" asp-action="Create" asp-controller="Post">
        Create New Post
    </a>
</div>
<hr />
<div class="row row-cols-3 g-4">
    @foreach (var post in Model)
    {
        <div class="col">
            <div class="card h-100  border-0 shadow-lg rounded-1 ">
                <img src="@post.FeatureImagePath"
                class="card-img-top" 
                alt="@post.Title"
                style="height:250px;object-fit:cover;">
                <div class="card-body">
                    <h5 class="card-title">@post.Title</h5>
                    <p class="text-muted mb-2">Published on: @post.PublishedDate.ToString("MM/dd/yyyy")</p>
                        <span class="badge bg-secondary">
                            @post.Category?.Name
                        </span>
                        <hr />
                    <p class="card-text">@post.Content</p>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <a class="btn btn-primary btn-sm " asp-action="Details" asp-controller="Post" asp-route-id="@post.Id" >Read More</a>
                    <small class="text-muted">Author :  @post.Author</small>
                </div>
            </div>
        </div>
    }
</div>